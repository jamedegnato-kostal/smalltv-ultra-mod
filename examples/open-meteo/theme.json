            ]
          ]
        }
      ]
    },
    {
      "id": "rain",
      "type": "text",
      "x": 120,
      "y": 48,
      "anchor": "center",
      "value": {
        "en": "Rain",
        "de": "Regen"
      },
      "size": 18,
      "color": "#78B7D0",
      "show": [
        {
          "source": "weather.code",
          "in": [
            [
              61,
              67
            ],
            [
              80,
              82
            ]
          ]
        }
      ]
    },
    {
      "id": "snow",
      "type": "text",
      "x": 120,
      "y": 48,
      "anchor": "center",
      "value": {
        "en": "Snow",
        "de": "Schnee"
      },
      "size": 18,
      "color": "#D7E8F5",
      "show": [
        {
          "source": "weather.code",
          "in": [
            [
              71,
              77
            ],
            [
              85,
              86
            ]
          ]
        }
      ]
    },
    {
      "id": "storm",
      "type": "text",
      "x": 120,
      "y": 48,
      "anchor": "center",
      "value": {
        "en": "Thunderstorm",
        "de": "Gewitter"
      },
      "size": 18,
      "color": "#C0A4F5",
      "show": [
        {
          "source": "weather.code",
          "in": [
            [
              95,
              99
            ]
          ]
        }
      ]
    },
    {
      "id": "humidity",
      "type": "text",
      "x": 120,
      "y": 145,
      "anchor": "center",
      "value": "Humidity {weather.humidity} %",
      "size": 14,
      "color": "#B8C7D9"
    },
    {
      "id": "wind",
      "type": "text",
      "x": 120,
      "y": 166,
      "anchor": "center",
      "value": "Wind {weather.wind} km/h",
      "size": 14,
      "color": "#B8C7D9"
    },
    {
      "id": "daily",
      "type": "text",
      "x": 120,
      "y": 194,
      "anchor": "center",
      "value": "{weather.minimum} / {weather.maximum} C",
      "size": 14,
      "color": "#FFFFFF"
    },
    {
      "id": "rain",
      "type": "text",
      "x": 120,
      "y": 217,
      "anchor": "center",
      "value": "Rain chance {weather.rain_chance} %",
      "size": 12,
      "color": "#78B7D0"
    },
    {
      "id": "day",
      "type": "text",
      "x": 120,
      "y": 68,
      "anchor": "center",
      "value": {
        "en": "DAY",
        "de": "TAG"
      },
      "size": 10,
      "color": "#F6D365",
      "show": [
        {
          "source": "weather.is_day",
          "in": [
            [
              1,
              1
            ]
          ]
        }
      ]
    },
    {
      "id": "night",
      "type": "text",
      "x": 120,
      "y": 68,
      "anchor": "center",
      "value": {
        "en": "NIGHT",
        "de": "NACHT"
      },
      "size": 10,
      "color": "#AFC8F0",
      "show": [
        {
          "source": "weather.is_day",
          "in": [
            [
              0,
              0
            ]
          ]
        }
      ]
    }
  ]
}
